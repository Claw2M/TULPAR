<Window x:Class="Tulpar.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TULPAR MISSION PLANNER"
        Icon="pack://application:,,,/Tulpar.App;component/Assets/Images/tulpar.ico"
        Width="640"
        Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display">
    <Border Background="#000000"
            BorderBrush="#3A3A3F"
            BorderThickness="1"
            Padding="28,22,28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Aerospace Micro Header -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="TULPAR // GROUND CONTROL STATION"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#9B9BA6" />
                <TextBlock DockPanel.Dock="Right"
                           Text="MAVLINK v2"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="10"
                           Foreground="#666670" />
            </DockPanel>

            <!-- Centered Winged Tulpar Logo -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Tulpar.App;component/Assets/Images/tulpar-splash.jpg"
                       Width="380"
                       Height="210"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" />
                <TextBlock Text="O T O N O M   U Ç U Ş   K O N T R O L   S İ S T E M İ"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="10"
                           Foreground="#9B9BA6"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Bottom Telemetry Boot Progress -->
            <StackPanel Grid.Row="2">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText"
                               DockPanel.Dock="Left"
                               Text="SİSTEM BAŞLATILIYOR..."
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="11"
                               Foreground="#F0F0FA"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PercentText"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               Text="%10"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="11"
                               Foreground="#9B9BA6"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar x:Name="BootProgress"
                             Minimum="0"
                             Maximum="100"
                             Value="10"
                             Height="3"
                             Style="{StaticResource SpaceXProgressBarStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
