<Window x:Class="Tulpar.App.Controls.OfflineMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ÇEVRİMDIŞI HARİTA &amp; MBTILES YÖNETİCİSİ"
        Width="700"
        Height="640"
        MinWidth="600"
        MinHeight="540"
        Background="#000000"
        Foreground="#FFFFFF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>
            <!-- HEADER -->
            <TextBlock Text="ÇEVRİMDIŞI HARİTA &amp; KARO ÖNBELLEK YÖNETİCİSİ"
                       FontFamily="{DynamicResource DisplayFontFamily}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#FFFFFF" />
            <TextBlock Text="SAHA UÇUŞU ÖNCESİ BÖLGE İNDİRİN, HARİCİ .MBTILES AKTARIN VEYA ÖZEL XYZ KATMANI TANIMLAYIN"
                       Style="{DynamicResource MicroCapTextStyle}"
                       FontSize="11"
                       Margin="0,4,0,14" />

            <!-- SECTION 1: BOUNDING-BOX REGION DOWNLOADER -->
            <Border Style="{DynamicResource HairlinePanelStyle}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="1. BÖLGE ÖNBELLEK İNDİRME (XYZ)"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HARİTA KATMANI" Style="{DynamicResource MicroCapTextStyle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ProviderCombo"
                                  Grid.Column="1"
                                  DisplayMemberPath="Name"
                                  Style="{DynamicResource SpaceXComboBoxStyle}"
                                  SelectionChanged="OnEstimateInputChanged" />
                        <Button Grid.Column="2"
                                Content="HARİTADAN SEÇ (SHIFT+SÜRÜKLE)"
                                Click="OnPickBoundsFromMapClick"
                                Style="{DynamicResource GhostPillButtonStyle}"
                                Padding="12,6"
                                FontSize="11"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MİN ENLEM" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MinLatBox" Text="39.8800" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MAKS ENLEM" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MaxLatBox" Text="39.9800" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="MİN BOYLAM" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MinLonBox" Text="32.7800" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="MAKS BOYLAM" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MaxLonBox" Text="32.9200" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MİN ZOOM (0..22)" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MinZoomBox" Text="10" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MAKS ZOOM (0..22)" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MaxZoomBox" Text="14" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="MAKS KARO SINIRI" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="MaxTilesBox" Text="2500" Style="{DynamicResource SpaceXTextBoxStyle}" TextChanged="OnEstimateInputChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TileEstimateText"
                               Text="TAHMİNİ KARO: --"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#F0F0FA"
                               Margin="0,2,0,4" />
                    <TextBlock Text="UYARI: AÇIK SUNUCULARDA HIZ SINIRI UYGULANIR (75MS/KARO). MAKS KARO SINIRINI AŞAN ALANLAR KIRPILIR."
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="11"
                               Foreground="#F0F0FA"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <ProgressBar x:Name="DownloadProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Style="{DynamicResource SpaceXProgressBarStyle}"
                                 Margin="0,0,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadStatusText"
                                   Grid.Column="0"
                                   Text="HAZIR"
                                   Style="{DynamicResource MicroCapTextStyle}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="CancelDownloadBtn"
                                Grid.Column="1"
                                Content="İPTAL"
                                Click="OnCancelDownloadClick"
                                Style="{DynamicResource DangerGhostPillButtonStyle}"
                                Padding="14,6"
                                FontSize="11"
                                IsEnabled="False"
                                Margin="8,0,6,0" />
                        <Button x:Name="StartDownloadBtn"
                                Grid.Column="2"
                                Content="BÖLGEYİ İNDİR"
                                Click="OnStartDownloadClick"
                                Style="{DynamicResource GhostPillButtonStyle}"
                                Padding="16,6"
                                FontSize="11" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 2: IMPORT .MBTILES -->
            <Border Style="{DynamicResource HairlinePanelStyle}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="2. HARİCİ .MBTILES ARŞİVİ İÇE AKTAR"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MbtilesPathBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 Text="QGIS / MOBAC İLE HAZIRLANMIŞ RASTER .MBTILES DOSYASI SEÇİN"
                                 Style="{DynamicResource SpaceXTextBoxStyle}" />
                        <Button Grid.Column="1"
                                Content=".MBTILES SEÇ &amp; EKLE"
                                Click="OnBrowseMbtilesClick"
                                Style="{DynamicResource GhostPillButtonStyle}"
                                Padding="14,6"
                                FontSize="11"
                                Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="MbtilesStatusText"
                               Style="{DynamicResource MicroCapTextStyle}"
                               FontSize="11"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- SECTION 3: CUSTOM XYZ URL PROVIDER -->
            <Border Style="{DynamicResource HairlinePanelStyle}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="3. ÖZEL XYZ KARO URL SAĞLAYICISI EKLE"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="KATMAN ADI" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="CustomNameBox" Text="ÖZEL KATMAN" Style="{DynamicResource SpaceXTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="XYZ URL ŞABLONU ({z}/{x}/{y})" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="CustomUrlBox" Text="https://tile.openstreetmap.org/{z}/{x}/{y}.png" Style="{DynamicResource SpaceXTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="MAKS Z" Style="{DynamicResource MicroCapTextStyle}" FontSize="10" />
                            <TextBox x:Name="CustomMaxZoomBox" Text="19" Style="{DynamicResource SpaceXTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CustomProviderStatusText"
                                   Grid.Column="0"
                                   Style="{DynamicResource MicroCapTextStyle}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="SAĞLAYICI EKLE"
                                Click="OnAddCustomProviderClick"
                                Style="{DynamicResource GhostPillButtonStyle}"
                                Padding="14,6"
                                FontSize="11" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FOOTER -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="KAPAT"
                        Click="OnCloseClick"
                        Style="{DynamicResource GhostPillButtonStyle}"
                        Padding="22,8"
                        FontSize="12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
