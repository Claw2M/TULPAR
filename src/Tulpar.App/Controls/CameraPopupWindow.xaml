<Window x:Class="Tulpar.App.Controls.CameraPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="TULPAR // KAMERA GÖRÜNTÜSÜ"
        Icon="pack://application:,,,/Tulpar.App;component/Assets/Images/tulpar.ico"
        Width="1120"
        Height="680"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#000000"
                BorderBrush="#3A3A3F"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KAMERA CANLI AKIŞ"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock x:Name="StatusBadgeText"
                               Text="SİNYAL BEKLENİYOR"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="11.5"
                               Foreground="#9B9BA6"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="OYNAT"
                            Command="{Binding StartVideoCommand}"
                            Style="{StaticResource GhostPillButtonStyle}"
                            MinHeight="28"
                            Padding="12,4"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="DUR"
                            Command="{Binding StopVideoCommand}"
                            Style="{StaticResource DangerGhostPillButtonStyle}"
                            MinHeight="28"
                            Padding="12,4"
                            FontSize="11"
                            Margin="0,0,10,0" />
                    <Button Content="✕ KAPAT"
                            Click="OnCloseClick"
                            Style="{StaticResource GhostPillButtonStyle}"
                            MinHeight="28"
                            Padding="14,4"
                            FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#000000">
            <vlc:VideoView x:Name="PopupVideoView"
                           Background="#000000"
                           Visibility="Collapsed" />

            <Border x:Name="PopupIdleOverlay"
                    Background="#0A0A0A"
                    Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock x:Name="PopupIdleTitle"
                               Text="SİNYAL BEKLENİYOR / KAMERA SEÇ"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="PopupIdleSubtitle"
                               Text="Üstteki 'OYNAT' butonunu veya ana ekrandaki kamera kaynağını kullanarak yayını başlatabilirsiniz."
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="13"
                               Foreground="#A0A0AC"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
