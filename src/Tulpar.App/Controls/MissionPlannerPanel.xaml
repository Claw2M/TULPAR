<UserControl x:Class="Tulpar.App.Controls.MissionPlannerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tulpar.App.ViewModels"
             x:Name="PlannerRoot"
             Background="#0A0A0A">
    <Grid>
        <TabControl Style="{DynamicResource SpaceXTabControlStyle}">
            <!-- GÖREV PLANLAYICI TAB -->
            <TabItem Header="GÖREV PLANI (WAYPOINTS)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Action Toolbar -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
                        <ToggleButton Content="HARİTADAN EKLE"
                                      IsChecked="{Binding IsMissionMapPickActive, Mode=OneWay}"
                                      Command="{Binding ToggleMissionMapEditCommand}"
                                      Margin="0,2,6,2"
                                      Padding="12,5"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}">
                                    <Setter Property="Background" Value="#000000" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border x:Name="BtnBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="32"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#FFFFFF" />
                                                        <Setter Property="Foreground" Value="#000000" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <TextBlock Text="YENİ KOMUT:" Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="4,0,4,0" />
                        <ComboBox ItemsSource="{Binding AvailableMissionCommands}"
                                  SelectedItem="{Binding SelectedNewMissionCommand}"
                                  Style="{DynamicResource SpaceXComboBoxStyle}"
                                  Width="165"
                                  Height="28"
                                  FontSize="11"
                                  Margin="0,2,6,2" />

                        <TextBlock Text="REF:" Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0" />
                        <ComboBox ItemsSource="{x:Static vm:EditableMissionItem.ReferenceFrameOptions}"
                                  SelectedItem="{Binding DefaultMissionFrameLabel}"
                                  Style="{DynamicResource SpaceXComboBoxStyle}"
                                  Width="72"
                                  Height="28"
                                  FontSize="11"
                                  Margin="0,2,6,2" />

                        <TextBlock Text="ALT(M):" Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0" />
                        <TextBox Text="{Binding DefaultWaypointAltitudeMeters, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource SpaceXTextBoxStyle}"
                                 Width="54"
                                 Height="28"
                                 FontSize="11"
                                 Margin="0,2,8,2" />

                        <Button Content="SATIR EKLE" Command="{Binding AddManualWaypointCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="YUKARI" Command="{Binding MoveWaypointUpCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="10,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="AŞAĞI" Command="{Binding MoveWaypointDownCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="10,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="SİL" Command="{Binding RemoveSelectedMissionWaypointCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="10,4" FontSize="11" Margin="0,2,10,2" />

                        <Button Content="ARACA YÜKLE" Command="{Binding UploadMissionCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="ARAÇTAN OKU" Command="{Binding DownloadMissionCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="TEMİZLE" Command="{Binding ClearMissionCommand}" Style="{DynamicResource DangerGhostPillButtonStyle}" Padding="10,4" FontSize="11" Margin="0,2,10,2" />

                        <Button Content="DOSYADAN AÇ" Click="OnImportMissionClick" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="DOSYAYA KAYDET" Click="OnExportMissionClick" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,0,2" />
                    </WrapPanel>

                    <!-- Waypoint DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MissionItems}"
                              SelectedItem="{Binding SelectedMissionItem}"
                              Style="{DynamicResource SpaceXDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Seq}" IsReadOnly="True" Width="42" />
                            <DataGridTemplateColumn Header="KOMUT" Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableMissionCommands, ElementName=PlannerRoot}"
                                                  SelectedItem="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{DynamicResource SpaceXComboBoxStyle}"
                                                  Height="24"
                                                  Padding="6,2"
                                                  FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="REFERANS (REL/AMSL)" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:EditableMissionItem.ReferenceFrameOptions}"
                                                  SelectedItem="{Binding ReferenceFrameLabel, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{DynamicResource SpaceXComboBoxStyle}"
                                                  Height="24"
                                                  Padding="6,2"
                                                  FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ENLEM" Binding="{Binding Latitude, StringFormat=F6, UpdateSourceTrigger=LostFocus}" Width="105" />
                            <DataGridTextColumn Header="BOYLAM" Binding="{Binding Longitude, StringFormat=F6, UpdateSourceTrigger=LostFocus}" Width="105" />
                            <DataGridTextColumn Header="İRTİFA (M)" Binding="{Binding Altitude, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Width="80" />
                            <DataGridTextColumn Header="PARAM 1" Binding="{Binding Param1, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Width="70" />
                            <DataGridTextColumn Header="PARAM 2" Binding="{Binding Param2, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Width="70" />
                            <DataGridTextColumn Header="PARAM 3" Binding="{Binding Param3, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Width="70" />
                            <DataGridTextColumn Header="PARAM 4" Binding="{Binding Param4, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Transfer Status Bar -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MissionTransferStatusText}"
                                   Style="{DynamicResource MicroCapTextStyle}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding MissionTransferProgressPercent}"
                                     Style="{DynamicResource SpaceXProgressBarStyle}"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- GEOFENCE TAB -->
            <TabItem Header="GEOFENCE (SINIR ÇOKGENİ)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
                        <ToggleButton Content="HARİTADAN ÇİZ"
                                      IsChecked="{Binding IsFenceMapPickActive, Mode=OneWay}"
                                      Command="{Binding ToggleFenceMapEditCommand}"
                                      Margin="0,2,6,2"
                                      Padding="12,5"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}">
                                    <Setter Property="Background" Value="#000000" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border x:Name="BtnBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="32"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#FFCC00" />
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFCC00" />
                                                        <Setter Property="Foreground" Value="#000000" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Button Content="KÖŞE SİL" Command="{Binding RemoveSelectedFencePointCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="YEREL TEMİZLE" Command="{Binding ClearFencePointsCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,10,2" />
                        <Button Content="GEOFENCE YÜKLE" Command="{Binding UploadFenceCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="GEOFENCE OKU" Command="{Binding DownloadFenceCommand}" Style="{DynamicResource GhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,4,2" />
                        <Button Content="OTOPİLOT TEMİZLE" Command="{Binding ClearFenceCommand}" Style="{DynamicResource DangerGhostPillButtonStyle}" Padding="12,4" FontSize="11" Margin="0,2,10,2" />

                        <TextBlock Text="{Binding GeofenceStatusSummary}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#F0F0FA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGeofenceBreached}" Value="True">
                                            <Setter Property="Foreground" Value="#FF3B30" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FencePoints}"
                              SelectedItem="{Binding SelectedFencePoint}"
                              Style="{DynamicResource SpaceXDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="ENLEM" Binding="{Binding Latitude, StringFormat=F6, UpdateSourceTrigger=LostFocus}" Width="160" />
                            <DataGridTextColumn Header="BOYLAM" Binding="{Binding Longitude, StringFormat=F6, UpdateSourceTrigger=LostFocus}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
