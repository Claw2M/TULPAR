<Window x:Class="Tulpar.App.Controls.LogPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TULPAR // SİSTEM VE TELEMETRİ GÜNLÜĞÜ"
        Icon="pack://application:,,,/Tulpar.App;component/Assets/Images/tulpar.ico"
        Width="780"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Arial, sans-serif"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0A0A0D"
                BorderBrush="#3A3A3F"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OLAY VE TELEMETRİ GÜNLÜĞÜ"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Logs.Count, StringFormat={}{0} KAYIT}"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="12"
                               Foreground="#9B9BA6"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="TÜMÜNÜ KOPYALA"
                            Click="OnCopyAllClick"
                            Style="{DynamicResource GhostPillButtonStyle}"
                            MinHeight="28"
                            Padding="12,4"
                            FontSize="11"
                            Margin="0,0,8,0" />
                    <Button Content="✕ KAPAT"
                            Click="OnCloseClick"
                            Style="{DynamicResource GhostPillButtonStyle}"
                            MinHeight="28"
                            Padding="12,4"
                            FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Logs}"
                 ItemContainerStyle="{DynamicResource SpaceXLogItemStyle}"
                 Background="#000000"
                 BorderThickness="0"
                 Padding="10"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLine}"
                               FontFamily="Segoe UI, Consolas, Arial, sans-serif"
                               FontSize="14"
                               LineHeight="20"
                               TextOptions.TextFormattingMode="Display"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="#F2F2FA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Foreground" Value="#FFD60A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Foreground" Value="#FF453A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                        <Setter Property="Foreground" Value="#FF453A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                                        <Setter Property="Foreground" Value="#FF453A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
