<UserControl x:Class="Tulpar.App.Controls.MapHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#000000">
    <Border x:Name="OuterBorder"
            Background="#000000"
            BorderBrush="#3A3A3F"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCameraPrimary}" Value="True">
                        <Setter Property="CornerRadius" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <wv2:WebView2 x:Name="MapWebView"
                          DefaultBackgroundColor="Black" />

            <Border x:Name="MapFallbackOverlay"
                    Background="#0A0A0A"
                    Visibility="Visible">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="16">
                    <TextBlock x:Name="FallbackTitleText"
                               Text="TAKTİK HARİTA YÜKLENİYOR"
                               FontFamily="{DynamicResource DisplayFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock x:Name="FallbackSubtitleText"
                               Text="MAPLIBRE GL JS · ÇEVRİMDIŞI ÖNBELLEK MOTORU"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="11"
                               Foreground="#F0F0FA"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
