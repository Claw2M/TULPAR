<Window x:Class="Tulpar.App.Controls.SafetyConfirmPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TULPAR // GÜVENLİK ONAYI"
        Icon="pack://application:,,,/Tulpar.App;component/Assets/Images/tulpar.ico"
        Width="470"
        SizeToContent="Height"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{DynamicResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Tulpar.App;component/Themes/SpaceXTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#FF3B30" BorderThickness="1.5" Background="#000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#0A0A0A"
                    BorderBrush="#3A3A3F"
                    BorderThickness="0,0,0,1"
                    Padding="16,11">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF3B30" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="ONAY"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   Text="GÜVENLİK ONAYI GEREKLİ"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF3B30"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Click="OnCancelClick"
                            Style="{StaticResource GhostPillButtonStyle}"
                            Padding="10,4"
                            FontSize="11"
                            ToolTip="İptal Et" />
                </DockPanel>
            </Border>

            <!-- BODY -->
            <StackPanel Grid.Row="1" Margin="16,14">
                <TextBlock x:Name="DescriptionText"
                           Text=""
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="13"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,12" />

                <Border Background="#0A0A0A"
                        BorderBrush="#27272A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="MOD:" Style="{StaticResource MicroCapTextStyle}" FontSize="10" Margin="0,0,5,0" />
                            <TextBlock x:Name="ModeBadgeText"
                                       Text="—"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="DURUM:" Style="{StaticResource MicroCapTextStyle}" FontSize="10" Margin="0,0,5,0" />
                            <TextBlock x:Name="ArmBadgeText"
                                       Text="DISARMED"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#FF3B30" />
                        </StackPanel>
                        <StackPanel x:Name="AltitudePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="HEDEF:" Style="{StaticResource MicroCapTextStyle}" FontSize="10" Margin="0,0,5,0" />
                            <TextBlock x:Name="AltitudeBadgeText"
                                       Text="—"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#34C759" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Background="#0A0A0A"
                    BorderBrush="#27272A"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ESC: İPTAL"
                               Style="{StaticResource MicroCapTextStyle}"
                               FontSize="10"
                               Foreground="#8E8E93"
                               VerticalAlignment="Center" />

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            Content="İPTAL ET"
                            IsCancel="True"
                            Click="OnCancelClick"
                            Style="{StaticResource GhostPillButtonStyle}"
                            Padding="18,8"
                            FontSize="11.5" />

                    <Button x:Name="ConfirmButton"
                            Grid.Column="3"
                            Content="ONAYLA VE GÖNDER"
                            Click="OnConfirmClick"
                            Style="{StaticResource DangerGhostPillButtonStyle}"
                            Padding="18,8"
                            FontSize="11.5" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
