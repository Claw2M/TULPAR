<UserControl x:Class="Tulpar.App.Controls.VideoFeedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="#0A0A0A">
    <Border x:Name="OuterFrame"
            Background="#0A0A0A"
            BorderBrush="#3A3A3F"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- LibVLCSharp VideoView (ForegroundWindow hosts overlay controls cleanly above native video/WebView2) -->
            <vlc:VideoView x:Name="VideoViewControl"
                           Background="#000000"
                           Visibility="Collapsed">
                <Grid x:Name="ForegroundRoot" Background="{x:Null}">
                    <!-- Idle / Fallback overlay when no stream is playing -->
                    <Border x:Name="NativeIdleOverlay"
                            Background="#0A0A0A"
                            Visibility="Visible">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="16">
                            <TextBlock x:Name="NativeOverlayTitleText"
                                       Text="SİNYAL BEKLENİYOR / KAMERA SEÇ"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="NativeOverlaySubtitleText"
                                       Text="RTSP · UDP/RTP · USB DIRECTSHOW"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="11"
                                       Foreground="#8E8E93"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Compact top overlay bar (Background transparent below bar so Map PiP remains interactive) -->
                    <Border VerticalAlignment="Top"
                            Background="#D9000000"
                            BorderBrush="#3A3A3F"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="KAMERA"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#F0F0FA"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="NativeStatusText"
                                           Text=" · BEKLİYOR"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="11"
                                           Foreground="#8E8E93"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="YER DEĞİŞTİR"
                                    Command="{Binding SwapMapAndCameraCommand}"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="10,4"
                                    FontSize="10" />
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>

            <!-- Pure WPF fallback overlay used when unhosted (unit tests) or if native host is inactive -->
            <Border x:Name="WpfFallbackOverlay"
                    Background="#0A0A0A"
                    Visibility="Visible">
                <Grid>
                    <Border VerticalAlignment="Top"
                            Background="#000000"
                            BorderBrush="#3A3A3F"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="KAMERA · BEKLİYOR"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#F0F0FA"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="YER DEĞİŞTİR"
                                    Command="{Binding SwapMapAndCameraCommand}"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="10,4"
                                    FontSize="10" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16,36,16,16">
                        <TextBlock x:Name="FallbackOverlayTitleText"
                                   Text="SİNYAL BEKLENİYOR / KAMERA SEÇ"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="FallbackOverlaySubtitleText"
                                   Text="RTSP · UDP/RTP · USB DIRECTSHOW"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="11"
                                   Foreground="#8E8E93"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
