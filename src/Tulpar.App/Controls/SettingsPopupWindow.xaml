<Window x:Class="Tulpar.App.Controls.SettingsPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Tulpar.App.Themes"
        Title="TULPAR // AYARLAR"
        Icon="pack://application:,,,/Tulpar.App;component/Assets/Images/tulpar.ico"
        Width="540"
        Height="470"
        MinWidth="460"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{DynamicResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Tulpar.App;component/Themes/SpaceXTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <themes:EnumDisplayConverter x:Key="EnumDisplayConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0A0A0A"
                BorderBrush="#3A3A3F"
                BorderThickness="0,0,0,1"
                Padding="16,11">
            <DockPanel LastChildFill="False">
                <TextBlock Text="⚙ KOKPİT, KAMERA &amp; HARİTA AYARLARI"
                           FontFamily="{DynamicResource DisplayFontFamily}"
                           FontSize="13.5"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Content="✕ KAPAT"
                        Click="OnCloseClick"
                        Style="{DynamicResource GhostPillButtonStyle}"
                        MinHeight="28"
                        Padding="12,4"
                        FontSize="11" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16">
            <StackPanel>
                <!-- KAMERA & VIDEO AKIŞI -->
                <Border Background="#0A0A0A" BorderBrush="#3A3A3F" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="KAMERA &amp; VİDEO AKIŞI"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding VideoStatusText}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="11"
                                       Foreground="#A7B0C0"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="VİDEO KAYNAĞI TÜRÜ" Style="{DynamicResource MicroCapTextStyle}" FontSize="10.5" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding VideoSourceKinds}"
                                  SelectedItem="{Binding SelectedVideoSourceKind}"
                                  Style="{DynamicResource SpaceXComboBoxStyle}"
                                  Height="32"
                                  Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="AKIŞ ADRESİ / USB CİHAZI" Style="{DynamicResource MicroCapTextStyle}" FontSize="10.5" Margin="0,0,0,4" />

                        <!-- URL Input (UDP/RTSP) -->
                        <TextBox Text="{Binding VideoStreamInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,12">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource SpaceXTextBoxStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUsbVideoSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- USB DirectShow -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding IsUsbVideoSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableVideoDevices}"
                                      Text="{Binding VideoStreamInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Style="{DynamicResource SpaceXComboBoxStyle}"
                                      Height="32" />
                            <Button Grid.Column="2"
                                    Content="USB TARA"
                                    Command="{Binding RefreshVideoDevicesCommand}"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="12,4"
                                    FontSize="11" />
                        </Grid>

                        <WrapPanel>
                            <Button Content="▶ OYNAT"
                                    Command="{Binding StartVideoCommand}"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="16,6"
                                    FontSize="11"
                                    Margin="0,0,8,4" />
                            <Button Content="■ DURDUR"
                                    Command="{Binding StopVideoCommand}"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="14,6"
                                    FontSize="11"
                                    Margin="0,0,8,4" />
                            <Button Content="{Binding SwapButtonText}"
                                    Command="{Binding SwapMapAndCameraCommand}"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="14,6"
                                    FontSize="11"
                                    Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- HARİTA & ÇEVRİMDIŞI -->
                <Border Background="#0A0A0A" BorderBrush="#3A3A3F" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="HARİTA &amp; ÇEVRİMDIŞI KULLANIM"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,0,0,10" />
                        <WrapPanel>
                            <Button Content="ÇEVRİMDIŞI HARİTA / MBTILES YÖNETİCİSİ"
                                    Click="OnOpenOfflineMapClick"
                                    Style="{DynamicResource GhostPillButtonStyle}"
                                    Padding="14,7"
                                    FontSize="11"
                                    Margin="0,0,8,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- TELEMETRİ & GUIDED AYARLARI -->
                <Border Background="#0A0A0A" BorderBrush="#3A3A3F" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="UÇUŞ &amp; YANSITICI AYARLARI"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#FFCC00"
                                   Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="VARSAYILAN GUIDED İRTİFA (M):" Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right"
                                     Text="{Binding GuidedDefaultAltitudeMeters, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource SpaceXTextBoxStyle}"
                                     Width="90"
                                     Height="30" />
                        </DockPanel>

                        <CheckBox Content="{Binding UdpForwarderLabel}"
                                  IsChecked="{Binding IsUdpForwarderEnabled}"
                                  Style="{DynamicResource SpaceXCheckBoxStyle}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="SOL HUD &amp; TELEMETRİ PANELİNİ GÖSTER"
                                  IsChecked="{Binding IsLeftPanelVisible}"
                                  Style="{DynamicResource SpaceXCheckBoxStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
