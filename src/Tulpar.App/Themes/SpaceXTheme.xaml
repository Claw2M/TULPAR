<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:Tulpar.App.Themes">

    <themes:UppercaseContentConverter x:Key="UppercaseContentConverter" />
    <themes:EnumDisplayConverter x:Key="EnumDisplayConverter" />

    <!-- SpaceX Design System Color Tokens (DESIGN-spacex.md + Flight Safety Alerts) -->
    <Color x:Key="CanvasNightColor">#000000</Color>
    <Color x:Key="CanvasNightSoftColor">#0A0A0A</Color>
    <Color x:Key="CanvasLightColor">#FFFFFF</Color>
    <Color x:Key="CanvasCoolColor">#F0F0FA</Color>
    <Color x:Key="HairlineDarkColor">#3A3A3F</Color>
    <Color x:Key="HairlineLightColor">#E0E0E8</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OnPrimaryMuteColor">#F0F0FA</Color>
    <Color x:Key="InkColor">#000000</Color>
    <Color x:Key="InkMuteColor">#5A5A5F</Color>
    <Color x:Key="HazardRedColor">#FF3B30</Color>
    <Color x:Key="WarningAmberColor">#FFCC00</Color>

    <SolidColorBrush x:Key="CanvasNightBrush" Color="{StaticResource CanvasNightColor}" />
    <SolidColorBrush x:Key="CanvasNightSoftBrush" Color="{StaticResource CanvasNightSoftColor}" />
    <SolidColorBrush x:Key="CanvasLightBrush" Color="{StaticResource CanvasLightColor}" />
    <SolidColorBrush x:Key="CanvasCoolBrush" Color="{StaticResource CanvasCoolColor}" />
    <SolidColorBrush x:Key="HairlineDarkBrush" Color="{StaticResource HairlineDarkColor}" />
    <SolidColorBrush x:Key="HairlineLightBrush" Color="{StaticResource HairlineLightColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryMuteBrush" Color="{StaticResource OnPrimaryMuteColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkMuteBrush" Color="{StaticResource InkMuteColor}" />
    <SolidColorBrush x:Key="HazardRedBrush" Color="{StaticResource HazardRedColor}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />

    <!-- Radius Scale -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">32</CornerRadius>

    <!-- Typography Families (Embedded D-DIN with Condensed Industrial Fallbacks) -->
    <FontFamily x:Key="DisplayFontFamily">pack://application:,,,/Tulpar.App;component/Assets/Fonts/#D-DIN, Arial Narrow, Arial, Verdana</FontFamily>
    <FontFamily x:Key="UiFontFamily">pack://application:,,,/Tulpar.App;component/Assets/Fonts/#D-DIN, Arial Narrow, Arial, Verdana</FontFamily>

    <!-- Ghost Pill CTA Button (button-ghost-on-dark) -->
    <Style x:Key="GhostPillButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="32"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UppercaseContentConverter}}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OnPrimaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource CanvasNightBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource OnPrimaryMuteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource CanvasNightBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryMuteBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkMuteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Flight-Safety Ghost Pill Button (RTL / ARMED) -->
    <Style x:Key="DangerGhostPillButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource GhostPillButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource HazardRedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HazardRedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HazardRedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HazardRedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HazardRedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource HazardRedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkMuteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text Input (rounded.xs = 4, 1px #3a3a3f hairline) -->
    <Style x:Key="SpaceXTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource OnPrimaryMuteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Item for SpaceX Dark Dropdown -->
    <Style x:Key="SpaceXComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource OnPrimaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource CanvasNightBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource HairlineDarkBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox (rounded.xs = 4, 1px #3a3a3f hairline, flat popup without drop shadows) -->
    <Style x:Key="SpaceXComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SpaceXComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="FullAreaToggle"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ToggleButton x:Name="ArrowToggle"
                                              Grid.Column="1"
                                              Visibility="Collapsed"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False" />
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="8,1,4,1"
                                         Padding="0"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         Foreground="{TemplateBinding Foreground}"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         FontSize="{TemplateBinding FontSize}"
                                         CaretBrush="{StaticResource OnPrimaryBrush}"
                                         SelectionBrush="{StaticResource HairlineDarkBrush}"
                                         BorderThickness="0"
                                         FocusVisualStyle="{x:Null}"
                                         Focusable="True"
                                         Visibility="Collapsed"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" />
                                <Path Grid.Column="1"
                                      Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=ComboBorder}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0"
                                    Background="{StaticResource CanvasNightSoftBrush}"
                                    BorderBrush="{StaticResource HairlineDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FullAreaToggle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowToggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryMuteBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource OnPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Micro-Cap Eyebrow Text (12px uppercase #f0f0fa) -->
    <Style x:Key="MicroCapTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryMuteBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Display Telemetry Text (Bold uppercase) -->
    <Style x:Key="DisplayTelemetryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Flat Hairline Panel (#0a0a0a bg, 1px #3a3a3f border, CornerRadius=4, zero drop shadows) -->
    <Style x:Key="HairlinePanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- SpaceX Monochrome TabItem -->
    <Style x:Key="SpaceXTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HairlineDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UppercaseContentConverter}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource OnPrimaryMuteBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource OnPrimaryBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2" />
                            <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SpaceX Monochrome TabControl -->
    <Style x:Key="SpaceXTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SpaceXTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource CanvasNightBrush}"
                                BorderBrush="{StaticResource HairlineDarkBrush}"
                                BorderThickness="0,1,0,1">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Margin="0" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SpaceX Monochrome CheckBox -->
    <Style x:Key="SpaceXCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CheckBorder"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                Background="{StaticResource CanvasNightBrush}"
                                BorderBrush="{StaticResource HairlineDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Path x:Name="CheckMark"
                                  Data="M 3,8 L 6.5,11.5 L 13,4"
                                  Stroke="{StaticResource OnPrimaryBrush}"
                                  StrokeThickness="1.8"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"
                                          Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UppercaseContentConverter}}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource OnPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource OnPrimaryMuteBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SpaceX Monochrome ProgressBar -->
    <Style x:Key="SpaceXProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SpaceX Monochrome DataGrid -->
    <Style x:Key="SpaceXDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryMuteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="SpaceXDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource HairlineDarkBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CanvasNightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SpaceXDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource HairlineDarkBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SpaceXDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource CanvasNightSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
