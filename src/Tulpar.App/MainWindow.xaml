<Window x:Class="Tulpar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tulpar.App.Controls"
        xmlns:vm="clr-namespace:Tulpar.App.ViewModels"
        Title="TULPAR MISSION PLANNER"
        Width="1480"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{StaticResource UiFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP COMMAND BAR (48px min, wraps cleanly below 1280px) -->
            <RowDefinition Height="Auto" MinHeight="48" />
            <!-- COCKPIT BODY -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP COMMAND BAR -->
        <Border Grid.Row="0"
                Background="#000000"
                BorderBrush="#3A3A3F"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LEFT + CENTER WRAPPING GROUP -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                    <Button Content="PANEL"
                            Command="{Binding ToggleLeftPanelCommand}"
                            Style="{StaticResource GhostPillButtonStyle}"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,10,0" />

                    <TextBlock Text="TULPAR"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <ComboBox ItemsSource="{Binding ConnectionKinds}"
                              SelectedItem="{Binding SelectedConnectionKind}"
                              Width="84"
                              Height="30"
                              FontSize="11"
                              Margin="0,0,6,0">
                        <ComboBox.Style>
                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SpaceXComboBoxStyle}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransportConnected}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <!-- SERIAL INPUTS -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSerialConnection, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox ItemsSource="{Binding AvailableSerialPorts}"
                                  SelectedItem="{Binding SelectedSerialPort}"
                                  Style="{StaticResource SpaceXComboBoxStyle}"
                                  Width="92"
                                  Height="30"
                                  FontSize="11"
                                  Margin="0,0,4,0" />
                        <Button Content="YENİLE"
                                Command="{Binding RefreshSerialPortsCommand}"
                                Style="{StaticResource GhostPillButtonStyle}"
                                Padding="8,4"
                                FontSize="10"
                                Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding AvailableBaudRates}"
                                  SelectedItem="{Binding SelectedBaudRate}"
                                  Style="{StaticResource SpaceXComboBoxStyle}"
                                  Width="84"
                                  Height="30"
                                  FontSize="11"
                                  Margin="0,0,6,0" />
                    </StackPanel>

                    <!-- UDP INPUT -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsUdpConnection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PORT:" Style="{StaticResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding UdpListenPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SpaceXTextBoxStyle}"
                                 Width="68"
                                 Height="30"
                                 FontSize="11"
                                 Margin="0,0,6,0" />
                    </StackPanel>

                    <!-- TCP INPUTS -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsTcpConnection, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding TcpHost, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SpaceXTextBoxStyle}"
                                 Width="105"
                                 Height="30"
                                 FontSize="11"
                                 Margin="0,0,4,0" />
                        <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SpaceXTextBoxStyle}"
                                 Width="60"
                                 Height="30"
                                 FontSize="11"
                                 Margin="0,0,6,0" />
                    </StackPanel>

                    <Button Content="{Binding ConnectionButtonText}"
                            Command="{Binding ConnectOrDisconnectCommand}"
                            Style="{StaticResource GhostPillButtonStyle}"
                            Padding="14,5"
                            FontSize="11" />
                </StackPanel>

                <!-- AUTO VEHICLE BADGE + MODE + ARMED + STATUS STRIP -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <Border Background="#0A0A0A"
                            BorderBrush="#3A3A3F"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding VehicleBadgeText}"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ComboBox ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding SelectedMode}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource SpaceXComboBoxStyle}"
                              Width="126"
                              Height="30"
                              FontSize="11"
                              Margin="0,0,4,0" />
                    <Button Content="MOD"
                            Command="{Binding ApplySelectedModeCommand}"
                            Style="{StaticResource GhostPillButtonStyle}"
                            Padding="10,4"
                            FontSize="10"
                            Margin="0,0,8,0" />

                    <!-- ARMED / DISARMED BADGE -->
                    <Border CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="#0A0A0A" />
                                <Setter Property="BorderBrush" Value="#3A3A3F" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF3B30" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ArmedBadgeText}"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#5A5A5F" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                            <Setter Property="Foreground" Value="#FF3B30" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- BAT / GPS / RSSI -->
                    <TextBlock Text="BAT " Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BatteryDisplayText}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                        <Setter Property="Foreground" Value="#FFCC00" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBatteryCritical}" Value="True">
                                        <Setter Property="Foreground" Value="#FF3B30" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="GPS " Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GpsDisplayText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <TextBlock Text="RSSI " Style="{DynamicResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RssiDisplayText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <Border Background="#0A0A0A"
                            BorderBrush="#FF3B30"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            Visibility="{Binding LinkLost, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LINK LOST"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FF3B30" />
                    </Border>
                </StackPanel>
                </WrapPanel>

                <!-- RIGHT: GUARDED EMERGENCY ACTIONS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="HOLD"
                            Command="{Binding RequestHoldCommand}"
                            Style="{StaticResource GhostPillButtonStyle}"
                            Padding="14,5"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="RTL"
                            Command="{Binding RequestRtlCommand}"
                            Style="{StaticResource DangerGhostPillButtonStyle}"
                            Padding="16,5"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- COCKPIT BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN (360px, #0a0a0a, right 1px #3a3a3f, collapsible) -->
            <Border Grid.Column="0"
                    Width="360"
                    Background="#0A0A0A"
                    BorderBrush="#3A3A3F"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:HudControl Grid.Row="0"
                                         Snapshot="{Binding HudSnapshot}"
                                         VehicleProfile="{Binding ActiveProfile}"
                                         Height="250"
                                         Margin="8" />

                    <TabControl Grid.Row="1" Style="{StaticResource SpaceXTabControlStyle}">
                        <!-- TELEMETRİ TAB -->
                        <TabItem Header="TELEMETRİ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="İRTİFA (REL)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.AltitudeRelativeMeters, StringFormat={}{0:0.0} M}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="İRTİFA (AMSL)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.AltitudeAmslMeters, StringFormat={}{0:0.0} M}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="HAVA HIZI (IAS)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.AirspeedMps, StringFormat={}{0:0.0} M/S}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="YER HIZI (GS)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.GroundspeedMps, StringFormat={}{0:0.0} M/S}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="DİKEY HIZ (VSI)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.VerticalSpeedMps, StringFormat={}{0:+0.0;-0.0;0.0} M/S}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="HOME MESAFE" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding HomeDistanceDisplayText}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="BATARYA" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding BatteryDisplayText}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="16" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="AKIM / GAZ" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="16">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:0.0}A · %{1}">
                                                        <Binding Path="Snapshot.BatteryCurrentAmps" />
                                                        <Binding Path="Snapshot.ThrottlePercent" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="BAŞ AÇISI (HDG)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.HeadingDeg, StringFormat={}{0:000}°}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="18" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="ROLL / PITCH" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="16">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:0}° / {1:0}°">
                                                        <Binding Path="Snapshot.RollDeg" />
                                                        <Binding Path="Snapshot.PitchDeg" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="ENLEM (LAT)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.Latitude, StringFormat={}{0:0.000000}}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="14" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HairlinePanelStyle}" Margin="3" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="BOYLAM (LON)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                            <TextBlock Text="{Binding Snapshot.Longitude, StringFormat={}{0:0.000000}}" Style="{StaticResource DisplayTelemetryTextStyle}" FontSize="14" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- KOMUTLAR TAB -->
                        <TabItem Header="KOMUTLAR">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                                <StackPanel>
                                    <!-- SAFETY ARM/DISARM + TAKEOFF/LAND -->
                                    <Border Style="{StaticResource HairlinePanelStyle}" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="UÇUŞ EMNİYET KOMUTLARI (ÇİFT ONAYLI)" Style="{StaticResource MicroCapTextStyle}" FontSize="11" Margin="0,0,0,8" />

                                            <Button Command="{Binding RequestArmOrDisarmCommand}"
                                                    Margin="0,0,0,8">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DangerGhostPillButtonStyle}">
                                                        <Setter Property="Content" Value="ARM ET (GÜVENLİK ONAYLI)" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                                <Setter Property="Content" Value="DISARM ET (MOTOR DURDUR)" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="İRTİFA(M):" Style="{StaticResource MicroCapTextStyle}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Grid.Column="1" Text="{Binding TakeoffAltitudeMeters, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SpaceXTextBoxStyle}" Height="30" Margin="0,0,8,0" />
                                                <Button Grid.Column="2" Content="KALKIŞ (TAKEOFF)" Command="{Binding RequestTakeoffCommand}" Style="{StaticResource GhostPillButtonStyle}" Padding="10,6" FontSize="11" />
                                            </Grid>

                                            <UniformGrid Columns="2">
                                                <Button Content="İNİŞ (LAND)" Command="{Binding RequestLandCommand}" Style="{StaticResource GhostPillButtonStyle}" Padding="10,6" FontSize="11" Margin="0,0,4,0" />
                                                <Button Content="HOME GÜNCELLE" Command="{Binding SetHomeCurrentCommand}" Style="{StaticResource GhostPillButtonStyle}" Padding="10,6" FontSize="11" Margin="4,0,0,0" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- PAYLOAD / SERVO -->
                                    <Border Style="{StaticResource HairlinePanelStyle}" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="FAYDALI YÜK / SERVO (DO_SET_SERVO)" Style="{StaticResource MicroCapTextStyle}" FontSize="11" Margin="0,0,0,8" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="KANAL (1..16)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                                    <TextBox Text="{Binding ServoChannel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SpaceXTextBoxStyle}" Height="30" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="PWM (US)" Style="{StaticResource MicroCapTextStyle}" FontSize="10" />
                                                    <TextBox Text="{Binding ServoPwm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SpaceXTextBoxStyle}" Height="30" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="SERVO TETİKLE" Command="{Binding TriggerServoCommand}" Style="{StaticResource GhostPillButtonStyle}" Padding="12,6" FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                    <!-- UDP FORWARDER + GUIDED ALT -->
                                    <Border Style="{StaticResource HairlinePanelStyle}" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="TELEMETRİ YANSITMA &amp; GUIDED AYARI" Style="{StaticResource MicroCapTextStyle}" FontSize="11" Margin="0,0,0,8" />
                                            <CheckBox IsChecked="{Binding IsUdpForwarderEnabled}"
                                                      Content="{Binding UdpForwarderEndpointText, StringFormat=UDP YANSITICI ({0})}"
                                                      Style="{StaticResource SpaceXCheckBoxStyle}"
                                                      Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="VARSAYILAN GUIDED İRTİFA (M):" Style="{StaticResource MicroCapTextStyle}" FontSize="10" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding GuidedDefaultAltitudeMeters, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SpaceXTextBoxStyle}" Height="28" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- GÜNLÜK TAB -->
                        <TabItem Header="GÜNLÜK">
                            <ListBox ItemsSource="{Binding Logs}"
                                     Background="#000000"
                                     BorderThickness="0"
                                     Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLine}"
                                                   FontFamily="{StaticResource UiFontFamily}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#F0F0FA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#FFCC00" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Foreground" Value="#FF3B30" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Foreground" Value="#FF3B30" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Emergency">
                                                            <Setter Property="Foreground" Value="#FF3B30" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- RIGHT AREA: STAGE BAR + BANNERS + MAIN STAGE + BOTTOM DRAWER -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- STAGE CONTROL BAR + SAFETY / GEOFENCE ALERTS -->
                <StackPanel Grid.Row="0" Background="#000000">
                    <Border BorderBrush="#3A3A3F" BorderThickness="0,0,0,1" Padding="10,5">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- MAP CONTROLS -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                <TextBlock Text="HARİTA:" Style="{StaticResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="MapLayerCombo"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnMapLayerSelectionChanged"
                                          Style="{StaticResource SpaceXComboBoxStyle}"
                                          Width="150"
                                          Height="28"
                                          FontSize="11"
                                          Margin="0,0,6,0" />
                                <Button Content="ÇEVRİMDIŞI HARİTA / MBTILES"
                                        Click="OnOpenOfflineMapDialogClick"
                                        Style="{StaticResource GhostPillButtonStyle}"
                                        Padding="12,4"
                                        FontSize="10"
                                        Margin="0,0,6,0" />
                                <Button Content="ARACA ODAKLAN"
                                        Click="OnCenterOnVehicleClick"
                                        Style="{StaticResource GhostPillButtonStyle}"
                                        Padding="10,4"
                                        FontSize="10" />
                            </StackPanel>

                            <!-- CAMERA SOURCE + SWAP -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                <TextBlock Text="KAMERA:" Style="{StaticResource MicroCapTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding VideoSourceKinds}"
                                          SelectedItem="{Binding SelectedVideoSourceKind}"
                                          Style="{StaticResource SpaceXComboBoxStyle}"
                                          Width="112"
                                          Height="28"
                                          FontSize="11"
                                          Margin="0,0,4,0" />

                                <!-- URL Input (UDP/RTSP) -->
                                <TextBox Text="{Binding VideoStreamInput, UpdateSourceTrigger=PropertyChanged}"
                                         Width="180"
                                         Height="28"
                                         FontSize="11"
                                         Margin="0,0,4,0">
                                    <TextBox.Style>
                                        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource SpaceXTextBoxStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUsbVideoSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- USB DirectShow Device Picker -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsUsbVideoSelected, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox ItemsSource="{Binding AvailableVideoDevices}"
                                              Text="{Binding VideoStreamInput, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Style="{StaticResource SpaceXComboBoxStyle}"
                                              Width="150"
                                              Height="28"
                                              FontSize="11"
                                              Margin="0,0,4,0" />
                                    <Button Content="TARA"
                                            Command="{Binding RefreshVideoDevicesCommand}"
                                            Style="{StaticResource GhostPillButtonStyle}"
                                            Padding="8,4"
                                            FontSize="10"
                                            Margin="0,0,4,0" />
                                </StackPanel>

                                <Button Content="OYNAT"
                                        Command="{Binding StartVideoCommand}"
                                        Style="{StaticResource GhostPillButtonStyle}"
                                        Padding="10,4"
                                        FontSize="10"
                                        Margin="0,0,4,0" />
                                <Button Content="DUR"
                                        Command="{Binding StopVideoCommand}"
                                        Style="{StaticResource GhostPillButtonStyle}"
                                        Padding="10,4"
                                        FontSize="10"
                                        Margin="0,0,6,0" />
                                <Button Content="{Binding SwapButtonText}"
                                        Command="{Binding SwapMapAndCameraCommand}"
                                        Style="{StaticResource GhostPillButtonStyle}"
                                        Padding="12,4"
                                        FontSize="10" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- SAFETY CONFIRMATION BANNER -->
                    <Border Background="#0A0A0A"
                            BorderBrush="#FF3B30"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="10,8,10,0"
                            Padding="12,8"
                            Visibility="{Binding HasPendingSafetyAction, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingSafetyAction.Title}"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF3B30" />
                                <TextBlock Text="{Binding PendingSafetyAction.Description}"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           FontSize="12"
                                           Foreground="#FFFFFF"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="ONAYLA"
                                        Command="{Binding ConfirmSafetyActionCommand}"
                                        Style="{StaticResource DangerGhostPillButtonStyle}"
                                        Padding="16,6"
                                        FontSize="11"
                                        Margin="0,0,6,0" />
                                <Button Content="İPTAL"
                                        Command="{Binding CancelSafetyActionCommand}"
                                        Style="{StaticResource GhostPillButtonStyle}"
                                        Padding="14,6"
                                        FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- GEOFENCE BREACH ALERT BANNER -->
                    <Border Background="#0A0A0A"
                            BorderBrush="#FF3B30"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="10,6,10,6"
                            Padding="12,6"
                            Visibility="{Binding IsGeofenceBreached, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding GeofenceAlertMessage}"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF3B30" />
                    </Border>
                </StackPanel>

                <!-- MAIN STAGE: FULL-BLEED MAP / CAMERA SWAP + 8PX ROUNDED PIP IN BOTTOM-RIGHT -->
                <Grid x:Name="StageGrid" Grid.Row="1" Background="#000000">
                    <controls:MapHostControl x:Name="MapHost">
                        <controls:MapHostControl.Style>
                            <Style TargetType="{x:Type controls:MapHostControl}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Panel.ZIndex" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraPrimary}" Value="True">
                                        <Setter Property="Width" Value="340" />
                                        <Setter Property="Height" Value="215" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Bottom" />
                                        <Setter Property="Margin" Value="0,0,16,16" />
                                        <Setter Property="Panel.ZIndex" Value="10" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:MapHostControl.Style>
                    </controls:MapHostControl>

                    <controls:VideoFeedControl x:Name="VideoFeed">
                        <controls:VideoFeedControl.Style>
                            <Style TargetType="{x:Type controls:VideoFeedControl}">
                                <Setter Property="Width" Value="340" />
                                <Setter Property="Height" Value="215" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                <Setter Property="Margin" Value="0,0,16,16" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraPrimary}" Value="True">
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Height" Value="Auto" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Panel.ZIndex" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:VideoFeedControl.Style>
                    </controls:VideoFeedControl>
                </Grid>

                <!-- COLLAPSIBLE BOTTOM MISSION & GEOFENCE DRAWER -->
                <Border Grid.Row="2"
                        Background="#000000"
                        BorderBrush="#3A3A3F"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,0">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="GÖREV &amp; GEOFENCE PLANLAYICI"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding MissionItems.Count, StringFormat={}{0} WAYPOINT}"
                                               Style="{StaticResource MicroCapTextStyle}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding GeofenceStatusSummary}"
                                               Style="{StaticResource MicroCapTextStyle}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ToggleMissionDrawerCommand}"
                                        Padding="12,3"
                                        FontSize="10"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostPillButtonStyle}">
                                            <Setter Property="Content" Value="AÇ" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissionDrawerExpanded}" Value="True">
                                                    <Setter Property="Content" Value="DARALT" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>
                        </Border>

                        <controls:MissionPlannerPanel Grid.Row="1"
                                                      Height="235"
                                                      Visibility="{Binding IsMissionDrawerExpanded, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
